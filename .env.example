# Vrelo — environment variables. Copy to .env.local for local dev; set real
# values in the Vercel project settings. NEVER commit real secrets.

# Resend (contact form email)
RESEND_API_KEY=
# Verified sender address, e.g. "Vrelo <kontakt@vrelo-ki.de>"
CONTACT_FROM=
# Inbox that receives contact-form submissions
CONTACT_TO=
# Cal.com booking link (public), e.g. "vrelo/kennenlernen"
NEXT_PUBLIC_CAL_LINK=

# Newsletter (Phase 4b) — double opt-in.
# These are SERVER-ONLY — never prefix with NEXT_PUBLIC_ (that would ship the
# HMAC secret to the browser).
# Long random string used to sign the confirmation token
NEWSLETTER_SECRET=
# Resend Segment id that confirmed subscribers are added to (Resend renamed
# "Audiences" to "Segments" — this is the segment's UUID).
NEWSLETTER_SEGMENT_ID=
# Sender address for newsletter broadcasts, e.g. "Vrelo <newsletter@vrelo-ki.de>".
# Replies + bounces land here (reply-to = from). Needs a real, monitored mailbox.
# Falls back to CONTACT_FROM if unset.
NEWSLETTER_FROM=

# Public production base URL (e.g. https://vrelo-ki.de). Unset → falls back to
# the Vercel deployment URL. Drives canonicals, OG, sitemap and robots.
NEXT_PUBLIC_SITE_URL=

# Interactive demo (/demo) – Claude Haiku sandbox bot
ANTHROPIC_API_KEY=              # server-side only; if unset, /demo shows "bald verfügbar"
DEMO_DAILY_BUDGET=500           # max model calls per UTC day before /demo goes dark
# Vercel KV (Upstash) – per-IP rate limit + daily budget counter
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Unlisted blueprint page for agencies: /bauplan/<BAUPLAN_CODE>. Any other slug
# is a 404. Change the value to retire a leaked link. Server-only.
BAUPLAN_CODE=

# Prozess-Check sending caps: salt for the hashed e-mail keys in Upstash. Empty =
# built-in default. Changing it resets the one-PDF-per-address window. Server-only.
PC_HASH_SALT=

# Prozess-Check research (Plan 2): the n8n webhook on server1 that takes the
# research job (no contact data). Research and the KI consent sentence run only
# when both of these are set. Server-only.
N8N_PC_WEBHOOK_URL=
# Shared secret for the x-vrelo-secret header both ways (website to n8n and back).
# At least 32 random bytes as hex (64+ hex chars, else research stays off):
# openssl rand -hex 32. Server-only.
PC_SHARED_SECRET=
