        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "uufMxsjQ3EbiAu1g",
          "cachedResultName": "pc_runs"
        },
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Hängende Läufe').item.json.id }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "failed",
            "finishedAt": "={{ $now.toISO() }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "status",
              "displayName": "status",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true,
              "readOnly": false,
              "removed": false
            },
            {
              "id": "finishedAt",
              "displayName": "finishedAt",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "dateTime",
              "canBeUsedToMatch": true,
              "readOnly": false,
              "removed": false
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "notes": "Only after a 2xx: otherwise the row stays running and the next sweep tries again."
    },
    {
      "id": "e83a1d02-452e-4e18-b465-bd6c7bd6d66f",
      "name": "Alte Läufe löschen",
