{
  "name": "pc-sweep",
  "id": "bKNRGEJEeKPcCGuJ",
  "active": false,
  "nodes": [
    {
      "id": "0bed9eac-02bb-4be1-b79a-f2276cd216bd",
      "name": "Alle 15 Minuten",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "36b15034-dd04-40a7-b88b-2bc295bf8dbe",
      "name": "Manuell testen",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        480,
        500
      ],
      "parameters": {}
    },
    {
      "id": "f3fa5cbd-bbef-4694-9056-267772aff102",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        720,
        300
      ],
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"deliverUrl\": \"https://vrelo-ki.de/api/prozess-check/deliver\"\n}",
        "options": {}
      },
      "notes": "PC_DELIVER_URL, caps, estimates and prices (no n8n Variables on this licence). deliverUrl also sits in pc-error and pc-sweep."
    },
    {
      "id": "a79942ed-e9d6-4b78-b7e9-be1d809f2e15",
      "name": "Hängende Läufe",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        960,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "uufMxsjQ3EbiAu1g",
          "cachedResultName": "pc_runs"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "running"
            },
            {
              "keyName": "startedAt",
              "condition": "lt",
              "keyValue": "={{ $now.minus({ minutes: 30 }).toISO() }}"
            }
          ]
        },
        "returnAll": true
      }
    },
    {
      "id": "f377252a-db2b-46eb-8a37-2a0830aff5a0",
      "name": "Fallback senden",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.deliverUrl }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jobId: $json.jobId, fallback: true, grund: 'n8n-Fehler: Recherche lief über 30 Minuten', erlaubteQuellen: [] }) }}",
        "options": {
          "timeout": 60000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "SCCkcZm64X10tM4I",
          "name": "Prozess-Check Secret"
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "31b5eff0-bda0-484c-9e55-947659de06fd",
      "name": "Fallback angekommen?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "e3dc608d-cb42-4a98-b317-0ff6fb01baba",
              "leftValue": "={{ $json.statusCode >= 200 && $json.statusCode < 300 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "b1408de8-1685-4bb0-8c42-3f70442ae2a2",
      "name": "Als failed markieren",
